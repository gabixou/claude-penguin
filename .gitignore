# tools/ e versionado (bake scripts, probes, analise) — clones precisam
# dele p/ regenerar os assets a partir do wand. So ignora o que e
# regeneravel/local:
tools/node_modules/
tools/shots/
tools/.visual-qa/
# deploy: contem IP/paths do VPS — scripts ficam so no disco local
tools/deploy/
# SWFs originais do wand — assets de terceiros, ficam so no disco local
*.swf

# Atlases de characters gerados por tools/atlas/bake-char-atlas.mjs
# (binarios grandes; regenerar via bake — fontes sao os SWFs do wand)
client/public/assets/**/chars/

# Faxina tools/: probes one-off, dumps de analise e dirs de trabalho
# ficam so no disco local. Os keepers de misc/ seguem rastreados
# (gitignore nao afeta arquivo ja versionado).
tools/_*
tools/capture/
tools/cp-swf/
tools/legacy-analysis/
tools/qa/
tools/swfs/
tools/misc/
tools/.qa-prompt.txt
tools/visual-qa-prompt-*.txt
tools/qa-prompt-*.txt
