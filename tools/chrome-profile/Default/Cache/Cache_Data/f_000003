    upsertRemotePlayer(playerId, x = 380, y = 300, color = null, paperdoll = null) {
        let penguin = this.remotePlayers.get(playerId);
        if (!penguin) {
            const colors = [0xe74c3c, 0x2ecc71, 0x9b59b6, 0xf39c12, 0xff55aa, 0x34495e, 0x16a085];
            const chosenColor = color || colors[Math.floor(Math.random() * colors.length)];
            penguin = new Penguin(this, x, y, playerId, playerId, chosenColor);
            this.remotePlayers.set(playerId, penguin);
        }
        if (paperdoll) penguin.applyOutfit(paperdoll);
        return penguin;
    }

    handleAction(name) {
        if (!this.localPlayer) return;
        switch (name) {
            case 'dance': this.localPlayer.playEmote('dance'); break;
            case 'wave': this.localPlayer.playEmote('wave'); break;
            case 'throw': this.localPlayer.playEmote('throw'); break;
            case 'sit': this.localPlayer.sit(); break;
            case 'stand': this.localPlayer.stand(); break;
            case 'map': this.toggleMap(); break;
            case 'clothes': this.toggleClothes(); break;
        }
    }

    equipLocal(slot, itemId) {
        const current = this.localPlayer.gpaOutfit[slot];
        const next = current === itemId ? null : itemId;
        this.localPlayer.equip(slot, next);
        this.network.sendEquip(slot, next);
        this.refreshClothesSelection();
    }

