            btn.bg.fillRoundedRect(0, 0, 90, 26, 6);
            btn.bg.lineStyle(2, selected ? 0xffcc00 : 0x00aaff, 1);
            btn.bg.strokeRoundedRect(0, 0, 90, 26, 6);
