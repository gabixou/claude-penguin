        this.clothesOpen = !this.clothesOpen;
        this.clothesModal.setVisible(this.clothesOpen);
        this.setTreeInteractive(this.clothesModal, this.clothesOpen);
        if (this.clothesOpen) this.refreshClothesSelection();
    }

    changeRoom(newRoomKey) {
