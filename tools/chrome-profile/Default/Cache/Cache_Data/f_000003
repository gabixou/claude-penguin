            card.bg.fillStyle(equipped ? 0x0d47a1 : 0x005599, 1);
            card.bg.fillRoundedRect(0, 0, 100, 44, 6);
            card.bg.lineStyle(2, equipped ? 0xffcc00 : 0x00aaff, 1);
            card.bg.strokeRoundedRect(0, 0, 100, 44, 6);
