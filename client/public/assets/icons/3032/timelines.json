getClip._name);\n   targetClip.gotoAndStop(GEM_FRAME_LABEL);\n}\nvar GEM_GLOW_FRAME_LABEL = \"glow\";\nvar GEM_EMPTY_FRAME_LABEL = \"empty\";\nvar GEM_FRAME_LABEL = \"gem\";\nvar COMPLETE_RANK = 5;\nvar COMPLETE_RANK_SNOW = 13;\nvar SHELL = _global.getCurrentShell();\nvar amuletClip = itemClip.amuletClip;\nemptyAmulet();\nif(SHELL.getState() == SHELL.PLAY_STATE)\n{\n   SHELL.addListener(SHELL.GET_NINJA_RANKS,handleGetNinjaRanks);\n   SHELL.sendGetNinjaRanks(SHELL.getMyPlayerId());\n}","commands":[]}}},"sprites":{"5":{"frames":[[{"depth":1,"id":4,"matrix":[1,0,0,1,0,0]}]],"labels":{},"scriptFrames":[],"sounds":[]},"6":{"frames":[[{"depth":1,"id":3,"matrix":[1,0,0,1,0,0]},{"depth":2,"id":5,"matrix":[0.485504,-0.285599,0.285599,0.485504,-15.5,-14.55]}]],"labels":{},"scriptFrames":[],"sounds":[]},"9":{"frames":[[{"depth":1,"id":8,"matrix":[1,0,0,1,0,0]}]],"labels":{},"scriptFrames":[],"sounds":[]},"12":{"frames":[[{"depth":1,"id":11,"matrix":[1,0,0,1,0,0]}]],"labels":{},"scriptFrames":[],"sounds":[]},"13":{"frames":[[{"depth":1,"id":7,"matrix":[1,0,0,1,0,0]},{"depth":2,"id":9,"matrix":[-0.480469,0.874817,-0.874817,-0.480469,25.8,-12.25],"color":{"mult":[1,1,1,0.69921875],"add":[0,0,0,0]}},{"depth":4,"id":10,"matrix":[1,0,0,1,0,0]},{"depth":5,"id":5,"matrix":[1.011581,-0.205521,0.209824,1.032761,6.8,-13.05]},{"depth":7,"id":5,"matrix":[0.102158,-0.510269,0.52095,0.104294,4.4,3.05]}],[{"depth":1,"id":7,"matrix":[1,0,0,1,0,0]},{"depth":2,"id":9,"matrix":[-0.480469,0.874817,-0.874817,-0.480469,25.8,-12.25],"color":{"mult":[1,1,1,0.69921875],"add":[0,0,0,0]}},{"depth":4,"id":10,"matrix":[1,0,0,1,0,0]},{"depth":5,"id":5,"matrix":[1.011581,-0.205521,0.209824,1.032761,6.8,-13.05]},{"depth":7,"id":5,"matrix":[0.102158,-0.510269,0.52095,0.104294,4.4,3.05]},{"depth":9,"id":9,"matrix":[-0.480469,0.874817,-0.874817,-0.480469,25.8,-12.25],"color":{"mult":[0,0,0,1],"add":[255,74,58,0]},"ratio":1},{"depth":11,"id":9,"matrix":[-0.480469,0.874817,-0.874817,-0.480469,25.8,-12.25],"color":