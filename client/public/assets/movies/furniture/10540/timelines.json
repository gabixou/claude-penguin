StateByWeek(_loc1_,weekToStateLookup));\n      return undefined;\n   }\n   releaseEpoch += growthLoopInitialWeek * MILLISECONDS_IN_WEEK;\n   _loc1_ = getWeeksPassed(nowEpoch,releaseEpoch);\n   if(_loc1_ < 0)\n   {\n      return undefined;\n   }\n   weekToStateLookup = weekToStateLookup.slice(growthLoopInitialWeek,weekToStateLookup.length - 1);\n   sendPlantToState(getStateByWeek(_loc1_,weekToStateLookup));\n}\nfunction getWeeksPassed(startEpoch, endEpoch)\n{\n   if(isNaN(startEpoch) || isNaN(endEpoch))\n   {\n      return -1;\n   }\n   var _loc1_ = startEpoch - endEpoch;\n   return getNumberOfWeeksByMilliseconds(_loc1_) - 1;\n}\nfunction getNumberOfWeeksByMilliseconds(milliseconds)\n{\n   if(isNaN(milliseconds))\n   {\n      return -1;\n   }\n   return Math.floor(milliseconds / MILLISECONDS_IN_DAY / DAYS_IN_WEEK);\n}\nfunction getStateByWeek(week, weekToStateLookup)\n{\n   return weekToStateLookup[week % weekToStateLookup.length];\n}\nfunction sendPlantToState(state)\n{\n   gotoAndStop(state);\n}\nvar SHELL = _global.getCurrentShell();\nvar MILLISECONDS_IN_WEEK = 604800000;\nvar MILLISECONDS_IN_DAY = 86400000;\nvar DAYS_IN_WEEK = 7;\nvar RELEASE_YEAR = 2009;\nvar RELEASE_MONTH = 4;\nvar RELEASE_DAY = 22;\nvar nowDate = SHELL.getPenguinStandardTime();\nvar releaseDate = new Date(RELEASE_YEAR,RELEASE_MONTH,RELEASE_DAY);\nvar nowEpoch = nowDate.valueOf();\nvar releaseEpoch = releaseDate.valueOf();\nvar GROWTH_LOOP_INITIAL_WEEK = 6;\nvar weekToStateLookup = [];\nweekToStateLookup[0] = 1;\nweekToStateLookup[1] = 1;\nweekToStateLookup[2] = 2;\nweekToStateLookup[3] = 2;\nweekToStateLookup[4] = 3;\nweekToStateLookup[5] = 3;\nweekToStateLookup[6] = 4;\nweekToStateLookup[7] = 4;\nweekToStateLookup[8] = 5;\nweekToStateLookup[9] = 5;\nweekToStateLookup[10] = 6;\nweekToStateLookup[11] = 6;\nweekToStateLookup[12] = 7;\nweekToStateLookup[13] = 7;\nweekToStateLookup[14] = 8;\nweekToStateLookup[15] = 8;\nweekToStateLookup[16] = 9;\nweekToStateLookup[17] = 9;\nweekToStateLookup[18] =